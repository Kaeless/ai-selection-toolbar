<Window x:Class="AiSelectionToolbar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 划词工具栏" Icon="Assets/AppIcon.ico" Width="520" Height="62" MinWidth="520" MinHeight="62"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closed="Window_Closed" MouseLeftButtonDown="Header_MouseLeftButtonDown">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#F1F4F9"/>
      <Setter Property="Foreground" Value="#27354B"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Border x:Name="QuickPanel" Background="White" BorderBrush="#DEE5EF" BorderThickness="1" CornerRadius="14" Margin="5">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.17"/></Border.Effect>
    <ScrollViewer x:Name="QuickScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8,0">
    <StackPanel x:Name="QuickButtonStrip" Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="AccentBadge" Width="28" Height="28" CornerRadius="9" Background="#4F46E5" Margin="0,0,10,0">
        <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <Button Content="了解" Tag="explain" Click="Action_Click"/>
      <Button Content="详细解释" Tag="explain_detailed" Click="Action_Click"/>
      <Button Content="翻译" Tag="translate" Click="Action_Click"/>
      <Button Content="提问" Tag="ask" Click="Action_Click"/>
      <StackPanel x:Name="QuickCustomActions" Orientation="Horizontal"/>
      <Border Width="1" Background="#DDE4EE" Margin="6,8,10,8"/>
      <Button Content="⊘" Click="ExcludeCurrent_Click" ToolTip="在此程序隐藏" Padding="9,5" FontSize="17"/>
      <Button Content="×" Click="Close_Click" Padding="8,5" Margin="0" ToolTip="收起工具栏"/>
    </StackPanel>
    </ScrollViewer>
  </Border>
  <Border x:Name="ExpandedPanel" Visibility="Collapsed" Background="White" BorderBrush="#DEE5EF" BorderThickness="1" CornerRadius="16" Margin="5">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.17"/></Border.Effect>
    <Grid Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="31"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="复制" Click="Copy_Click" ToolTip="复制回答"/>
        <Button x:Name="NoteButton" Content="记笔记" Click="Note_Click" IsEnabled="False" ToolTip="编辑并保存解释"/>
        <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False"/>
        <Button Content="×" Click="Close_Click" Padding="9,5" Margin="0" ToolTip="关闭回答"/>
      </StackPanel>
      <Border Grid.Row="1" Background="#F7F9FC" CornerRadius="12" Margin="0,10,0,0" Padding="6">
        <RichTextBox x:Name="ResultView" IsReadOnly="True" IsDocumentEnabled="True" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" Background="Transparent" FontSize="14"
                     Foreground="#253348" SelectionBrush="#B9C7FF">
          <FlowDocument PagePadding="6" ColumnWidth="1000"><Paragraph>正在准备回答…</Paragraph></FlowDocument>
        </RichTextBox>
      </Border>
      <TextBlock x:Name="StatusLabel" Visibility="Collapsed" Text="就绪"/>
    </Grid>
  </Border>
  </Grid>
</Window>
