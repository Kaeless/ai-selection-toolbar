<Window x:Class="AiSelectionToolbar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 划词工具栏" Icon="Assets/AppIcon.ico" Width="430" Height="62" MinWidth="430" MinHeight="62"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closed="Window_Closed">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#F1F4F9"/>
      <Setter Property="Foreground" Value="#27354B"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Border x:Name="QuickPanel" Background="White" BorderBrush="#DEE5EF" BorderThickness="1" CornerRadius="14" Margin="5">
    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.17"/></Border.Effect>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="8,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="AccentBadge" Width="28" Height="28" CornerRadius="9" Background="#4F46E5" Margin="0,0,10,0">
        <TextBlock Text="A" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <Button Content="解释" Tag="explain" Click="Action_Click"/>
      <Button Content="翻译" Tag="translate" Click="Action_Click"/>
      <Button Content="提问" Tag="ask" Click="Action_Click"/>
      <StackPanel x:Name="QuickCustomActions" Orientation="Horizontal"/>
      <Border Width="1" Background="#DDE4EE" Margin="6,8,10,8"/>
      <Button Content="在此程序隐藏" Click="ExcludeCurrent_Click" ToolTip="将当前程序加入排除列表"/>
      <Button Content="×" Click="Close_Click" Padding="8,5" Margin="0" ToolTip="收起工具栏"/>
    </StackPanel>
    </ScrollViewer>
  </Border>
  <Border x:Name="ExpandedPanel" Visibility="Collapsed" Background="White" BorderBrush="#DEE5EF" BorderThickness="1" CornerRadius="16" Margin="5">
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.17"/></Border.Effect>
    <Grid Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="ExpandedAccentBadge" Width="25" Height="25" CornerRadius="8" Background="#4F46E5" Margin="0,0,9,0">
            <TextBlock Text="A" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="AI 划词工具栏" FontWeight="SemiBold" FontSize="15" Foreground="#16243A" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Column="1" Content="管理" Click="Manage_Click" ToolTip="打开本机设置与历史记录"/>
        <Button Grid.Column="2" Content="×" Click="Close_Click" Padding="9,4" Margin="0" ToolTip="收起工具栏"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,10,0,0">
        <TextBlock x:Name="SourceLabel" FontSize="11" Foreground="#72809A" Text="演示选区"/>
        <TextBox x:Name="SelectionText" Margin="0,5,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Height="54" Padding="8" BorderBrush="#DCE3EF" Text="选中一段文字后，会在这里显示。"/>
      </StackPanel>
      <WrapPanel Grid.Row="2" Margin="0,12,0,10">
        <Button Content="解释" Tag="explain" Click="Action_Click"/>
        <Button Content="翻译" Tag="translate" Click="Action_Click"/>
        <Button Content="提问" Tag="ask" Click="Action_Click"/>
        <WrapPanel x:Name="ExpandedCustomActions" MaxWidth="430"/>
        <Button Content="记笔记" Click="Note_Click"/>
        <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" Margin="0"/>
      </WrapPanel>
      <Border Grid.Row="3" Background="#F7F9FC" CornerRadius="10" Padding="10">
        <TextBox x:Name="ResultText" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto" Background="Transparent" FontSize="13"
                 Text="选择操作后，这里会逐段显示结果。"/>
      </Border>
      <Grid Grid.Row="4" Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusLabel" Text="就绪" FontSize="11" Foreground="#72809A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="1" Content="载入演示选区" Click="Demo_Click" Margin="0"/>
      </Grid>
    </Grid>
  </Border>
  </Grid>
</Window>
